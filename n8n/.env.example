# Copy to n8n/.env and fill in. Most values mirror your root .env.local / runner/.env.

# --- n8n core ---
# Generate once: `openssl rand -hex 32`. NEVER change after credentials are saved.
N8N_ENCRYPTION_KEY=
N8N_HOST=localhost
N8N_PROTOCOL=http
# In prod set to your public URL so webhooks resolve, e.g. https://n8n.yourdomain.com/
WEBHOOK_URL=http://localhost:5678/

# --- n8n metadata postgres ---
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-strong

# --- shared with your app (copy from .env.local) ---
MONGODB_URI=
TOKEN_ENC_KEY=
TAVILY_API_KEY=
HUNTER_API_KEY=
RUNNER_SECRET=

# --- LLM for the agents ($0 path) ---
# Free key from https://aistudio.google.com/apikey  (no card)
GEMINI_API_KEY=
# Optional: keep Claude available too (paid). Leave blank for $0.
ANTHROPIC_API_KEY=

# How n8n reaches the Next.js app (for revalidation / callbacks).
# Prod: your Vercel URL, e.g. https://app.biztreck.world
APP_BASE_URL=https://app.biztreck.world

# --- Cloudflare Tunnel ($0 exposure, used by docker-compose.tunnel.yml) ---
# From Cloudflare Zero Trust > Networks > Tunnels > (your tunnel) > token.
CF_TUNNEL_TOKEN=
