# ── MongoDB ────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/agentos

# ── Token encryption ───────────────────────────────────
# MUST match TOKEN_ENC_KEY in Next.js .env.local so tokens encrypted by
# NextAuth can be decrypted here.
TOKEN_ENC_KEY=

# ── AI ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Tavily Search — for the Lead Discovery agent. Free tier: 1000 q/month.
TAVILY_API_KEY=
# Hunter.io — email enrichment. Free tier: 25/month. https://hunter.io
HUNTER_API_KEY=

# ── Google OAuth (for refresh-token flow in tools) ─────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Runner security ────────────────────────────────────
# Same value as RUNNER_SECRET in Next.js .env.local
RUNNER_SECRET=

# ── SMTP (Nodemailer outbound; Gmail OAuth2 preferred) ─
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# ── Optional ───────────────────────────────────────────
APIFY_API_TOKEN=
SENTRY_DSN=
PORT=3001
