# ── App ────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 48
NEXTAUTH_SECRET=

# ── MongoDB ────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/agentos

# ── Token encryption (AES-256-GCM) ─────────────────────
# Any reasonably long random string. Used to encrypt Google OAuth tokens
# at rest in MongoDB. ROTATE THIS WILL INVALIDATE ALL STORED TOKENS.
# openssl rand -base64 48
TOKEN_ENC_KEY=

# ── Google OAuth (Gmail + Calendar via NextAuth) ───────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# ── AI ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Tavily Search — for the Lead Discovery agent. Free tier: 1000 q/month.
# Sign up at https://tavily.com → API Keys
TAVILY_API_KEY=
# Hunter.io — email enrichment for discovered prospects. Free tier: 25/month.
# Sign up at https://hunter.io → API
HUNTER_API_KEY=

# ── GitHub OAuth (Developer agent — connect repos) ─────
# Create an OAuth app: github.com/settings/applications/new
# Authorization callback URL: http://localhost:3000/api/integrations/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Agent runner (Railway) ─────────────────────────────
AGENT_RUNNER_URL=http://localhost:3001
# Shared secret between Next.js and Railway runner. Match in both envs.
RUNNER_SECRET=

# ── Redis (Upstash) — Phase 2 ──────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Social (Phase 2) ───────────────────────────────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
BUFFER_ACCESS_TOKEN=

# ── Storage / monitoring ───────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SENTRY_DSN=
